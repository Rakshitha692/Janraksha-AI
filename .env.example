# For MySQL: mysql+pymysql://USER:PASSWORD@localhost/janraksha
DATABASE_URL=sqlite:///janraksha.db
SECRET_KEY=replace-with-a-long-random-secret
MAX_UPLOAD_MB=5
MAX_VIDEO_UPLOAD_MB=100
MAX_VIDEO_SCAN_SECONDS=120
MAX_VIDEO_SAMPLE_FRAMES=60
POTENTIAL_MATCH_THRESHOLD=0.80

# SMTP settings for SOS email alerts and verified-case notifications.
# Replace every example value with credentials and sender details from your mail provider.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=JanRaksha AI <your-email@example.com>

# Optional SMTP compatibility settings for legacy deployments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JanRaksha AI <your-email@example.com>

# Browser push alerts (generate a VAPID key pair after installing requirements).
VAPID_PUBLIC_KEY=replace-with-vapid-application-server-key
VAPID_PRIVATE_KEY=./private_key.pem
VAPID_SUBJECT=mailto:admin@example.com
