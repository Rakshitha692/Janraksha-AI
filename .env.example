# For MySQL: mysql+pymysql://USER:PASSWORD@localhost/janraksha
DATABASE_URL=sqlite:///janraksha.db
SECRET_KEY=replace-with-a-long-random-secret
MAX_UPLOAD_MB=5
POTENTIAL_MATCH_THRESHOLD=0.80

# Mail delivery settings for verified-case notifications.
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=JanRaksha AI <your-email@example.com>

# Optional SMTP compatibility settings for legacy deployments.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=JanRaksha AI <your-email@example.com>
